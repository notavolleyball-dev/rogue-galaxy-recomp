diff --git a/ps2xRuntime/include/runtime/guest_host_writes.h b/ps2xRuntime/include/runtime/guest_host_writes.h
new file mode 100644
index 0000000..58dfc8f
--- /dev/null
+++ b/ps2xRuntime/include/runtime/guest_host_writes.h
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <cstddef>
+
+// Rogue Galaxy: a write into guest memory the kernel makes (an fread into
+// it reads straight into the destination) cannot fault and retry the way
+// the CPU's do. The game watches some of guest RAM for writes by keeping it
+// read-only (src/guest_write_watch.h): every such host read calls this
+// first with its destination, which the watch makes writable again.
+inline void (*g_beforeHostWrite)(void *at, size_t size) = nullptr;
+
+inline void beforeHostWrite(void *at, size_t size)
+{
+    if (void (*hook)(void *, size_t) = g_beforeHostWrite; hook && at && size)
+        hook(at, size);
+}
