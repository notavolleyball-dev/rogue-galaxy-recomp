+            return late;
+        }
+        m_eeTimerPendingCycles += eeCycles;
+        if (m_eeTimerPendingCycles < kEeTimerBatchCycles)
+        {
+            return late;
+        }
+        return late | flushEeTimerBatch();
+    }
