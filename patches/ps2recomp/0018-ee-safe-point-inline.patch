+    // Inline, the batch's flush out of line (Rogue Galaxy: changed).
+    uint32_t advanceEeTimers(uint64_t eeCycles) noexcept
+    {
+        const uint32_t late = m_eeTimerLateInterrupts;
+        m_eeTimerLateInterrupts = 0u;
