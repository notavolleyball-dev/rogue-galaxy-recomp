 void GSThreadedBackend::Sync(GSSyncReason reason)
 {
+    // A FINISH needs no answer on this side: the backend's part of it (the
+    // queued draws go to the GPU) runs in order on the worker, and the CSR
+    // bit is the front end's. Waiting for the whole queue there held the
+    // GS front end, which runs beside VU1, at every FINISH (Rogue Galaxy:
+    // changed, 2026-10-20). The syncs that read something back still wait.
+    if (reason == GSSyncReason::Finish)
+    {
+        m_impl->enqueue({Impl::Op::Sync, reason}, true);
+        return;
+    }
     m_impl->observe([&](auto &b) { b.Sync(reason); });
 }
