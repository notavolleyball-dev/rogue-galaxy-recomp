diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index d3311f8..6ac119f 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1501,7 +1501,18 @@ bool PS2Runtime::dispatchGuestBranch(uint8_t *rdram,
         return false;
     }
 
-    if (ctx->pc == entryPc)
+    // A host replacement that leaves pc at the entry has returned: continue
+    // at the fallthrough. Not when a checkpoint is unwinding the guest to the
+    // scheduler through this frame: the pc it carries is the entry of the
+    // function the innermost frame was about to call, and when that is the
+    // same function as this frame's callee (a recursive script VM, a
+    // re-entrant event runner) the two were told apart only by luck. Taking
+    // the unwind for a return resumed the caller with the innermost frame's
+    // registers and stack pointer, and the next epilogue read a stale slot:
+    // the game's main thread ended at pc 0 in a battle, and jumped to an
+    // address off the stack while loading (Rogue Galaxy: fixed, two freezes
+    // on 2026-10-19).
+    if (ctx->pc == entryPc && !(m_eeScheduler && m_eeScheduler->unwinding()))
     {
         ctx->pc = fallthroughPc;
     }
