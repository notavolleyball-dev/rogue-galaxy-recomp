diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index d3311f8..3976419 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1494,6 +1494,7 @@ bool PS2Runtime::dispatchGuestBranch(uint8_t *rdram,
     pushDispatchPc(targetPc);
     RecompiledFunction targetFn = *slot;
     const uint32_t entryPc = ctx->pc;
+    const uint32_t entrySp = static_cast<uint32_t>(_mm_extract_epi32(ctx->r[29], 0));
     targetFn(rdram, ctx, this);
 
     if (isStopRequested() || ctx->pc == 0u)
@@ -1501,7 +1502,21 @@ bool PS2Runtime::dispatchGuestBranch(uint8_t *rdram,
         return false;
     }
 
-    if (ctx->pc == entryPc)
+    // A host replacement that leaves pc at the entry has returned: continue
+    // at the fallthrough, but only with the stack pointer back where the
+    // call left it. A scheduler checkpoint unwinds the guest the same way,
+    // with pc at the entry of the function the innermost frame was about to
+    // call; when that is also this frame's callee (indirect recursion: the
+    // config script VM while loading, the action dispatch on a knockdown,
+    // the script runner on a skill) taking the unwind for a return resumed
+    // the caller with the innermost frame's registers and stack pointer, and
+    // the next epilogue read a stale slot: the main thread ended at pc 0, or
+    // jumped into its own stack (Rogue Galaxy: fixed, freezes on 2026-10-19).
+    // The unwind comes from a deeper frame, so its sp differs; a stub never
+    // leaves sp moved. A flag set by the checkpoint was tried first and went
+    // stale: the scheduler resumed another thread suspended inside a stub,
+    // its return was taken for an unwind, and the stub ran a second time.
+    if (ctx->pc == entryPc && static_cast<uint32_t>(_mm_extract_epi32(ctx->r[29], 0)) == entrySp)
     {
         ctx->pc = fallthroughPc;
     }
