+namespace
+{
+// A lower instruction that reads the status flags: FSEQ, FSAND, FSOR
+// (ops 0x14, 0x16, 0x17), unless the upper's I bit makes the lower word
+// a float immediate.
+bool vu1PairReadsStatus(const uint8_t *code, uint32_t pair)
+{
+    uint32_t words[2];
+    std::memcpy(words, code + pair * 8u, sizeof(words));
+    if ((words[1] & 0x80000000u) != 0u)
+        return false;
+    const uint32_t op = words[0] >> 25u;
+    return op == 0x14u || op == 0x16u || op == 0x17u;
+}
+} // namespace
+
+void PS2Memory::markVU1CodeWritten(uint32_t addr, uint32_t size)
+{
+    m_vu1CodeGeneration.fetch_add(1, std::memory_order_relaxed);
+    // A pending rescan covers these pairs too.
+    if (!m_vu1Code || m_vu1ReaderBitsStale.load(std::memory_order_relaxed))
+        return;
+    const uint32_t first = addr / 8u;
+    const uint32_t end = std::min<uint32_t>((addr + size + 7u) / 8u, PS2_VU1_CODE_SIZE / 8u);
+    for (uint32_t pair = first; pair < end; ++pair)
+    {
+        const uint64_t bit = 1ull << (pair & 63u);
+        if (vu1PairReadsStatus(m_vu1Code, pair))
+            m_vu1ReaderBits[pair >> 6u] |= bit;
+        else
+            m_vu1ReaderBits[pair >> 6u] &= ~bit;
+    }
+}
+
+bool PS2Memory::vu1StatusReadersPresent()
+{
+    if (m_vu1ReaderBitsStale.exchange(false, std::memory_order_relaxed))
+    {
+        m_vu1ReaderBits.fill(0u);
+        if (m_vu1Code)
+        {
+            for (uint32_t pair = 0u; pair < PS2_VU1_CODE_SIZE / 8u; ++pair)
+            {
+                if (vu1PairReadsStatus(m_vu1Code, pair))
+                    m_vu1ReaderBits[pair >> 6u] |= 1ull << (pair & 63u);
+            }
+        }
+    }
+    uint64_t any = 0u;
+    for (uint64_t word : m_vu1ReaderBits)
+        any |= word;
+    return any != 0u;
+}
