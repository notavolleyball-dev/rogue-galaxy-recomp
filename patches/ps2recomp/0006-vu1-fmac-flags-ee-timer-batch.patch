+// Whether any instruction of the image reads the status flags (FSEQ, FSAND,
+// FSOR), which every FMAC result adds to (sticky bits). Nothing else can
+// observe them: the EE reads only VU0's. A compiled run of such an image
+// queues every FMAC result; otherwise only the pairs whose MAC result a
+// reader can still see queue, which compile_vu_programs.py decides pair by
+// pair (the CLIP results always queue). Rogue Galaxy's images read status
+// flags nowhere and MAC flags in a few places. The memory keeps a bit per
+// pair as the code is written (PS2Memory::markVU1CodeWritten), so this is
+// a look at 32 words rather than a scan of the image after each of the
+// game's code uploads, which was 2% of the VIF1 thread.
+bool VU1Interpreter::fmacFlagsWanted(const uint8_t *vuCode, uint32_t codeSize, uint64_t generation)
+{
+    (void)vuCode;
+    (void)codeSize;
+    (void)generation;
+    // PS2X_VU_FMAC_FLAGS=1 keeps every result queued, for comparisons.
+    static const bool forced = [] {
+        const char *value = std::getenv("PS2X_VU_FMAC_FLAGS");
+        return value && *value == '1';
+    }();
+    if (forced || !m_activeMemory)
+        return true;
+    return m_activeMemory->vu1StatusReadersPresent();
+}
