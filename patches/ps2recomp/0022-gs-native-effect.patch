+bool GS::supportsNativeEffects() const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    return m_backend && m_backend->SupportsNativeEffects();
+}
+
+void GS::submitNativeEffect(const GSNativeEffect &effect)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (!m_backend || (effect.opCount == 0u && effect.command == GSNativeEffect::kSprites))
+        return;
+    bool fill = false;
+    for (uint32_t n = 0; n < effect.opCount && !fill; ++n)
+        fill = (effect.ops[n].flags & GSNativeEffect::kTexaFromGs) != 0u;
+    if (!fill)
+    {
+        m_backend->SubmitNativeEffect(effect);
+        return;
+    }
+    thread_local GSNativeEffect filled;
+    filled = effect;
+    for (uint32_t n = 0; n < filled.opCount; ++n)
+        if (filled.ops[n].flags & GSNativeEffect::kTexaFromGs)
+            filled.ops[n].texa = m_texa.ta0 | (m_texa.aem ? 0x8000u : 0u);
+    m_backend->SubmitNativeEffect(filled);
+}
