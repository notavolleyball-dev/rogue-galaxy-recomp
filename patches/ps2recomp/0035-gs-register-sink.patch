     }
 }
 
+namespace
+{
+thread_local GS::RegisterSink *t_registerSink = nullptr;
+}
+
+void GS::setRegisterSink(RegisterSink *sink)
+{
+    t_registerSink = sink;
+}
+
 void GS::writeRegister(uint8_t regAddr, uint64_t value)
 {
+    if (t_registerSink)
+    {
+        t_registerSink->emplace_back(regAddr, value);
+        return;
+    }
     GS_BOUNDARY(kRegister, "GS::writeRegister");
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     writeRegisterUnlocked(regAddr, value);
@@ -1801,6 +1816,8 @@ void GS::processImageData(const uint8_t *data, uint32_t sizeBytes)
 
 bool GS::clearFramebufferContext(uint32_t contextIndex, uint32_t rgba)
 {
+    if (t_registerSink)
+        return true;
     GS_BOUNDARY(kRegister, "GS::clearFramebufferContext");
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     return m_backend && m_backend->ClearFramebuffer(m_ctx[(contextIndex != 0u) ? 1 : 0], rgba);
@@ -1808,6 +1825,8 @@ bool GS::clearFramebufferContext(uint32_t contextIndex, uint32_t rgba)
 
 bool GS::clearActiveFramebuffer(uint32_t rgba)
 {
+    if (t_registerSink)
+        return true;
     GS_BOUNDARY(kRegister, "GS::clearActiveFramebuffer");
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     return m_backend && m_backend->ClearFramebuffer(activeContext(), rgba);
