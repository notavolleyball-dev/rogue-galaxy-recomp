+    // Rogue Galaxy: while a thread has a sink set, its writeRegister calls
+    // are appended to it instead of applied, and its framebuffer clears are
+    // dropped (the clear sprite that follows them is among the writes). The
+    // native pipeline replays them through its own producer, so the kernel
+    // stubs' draw environments and clears never reach the GS.
+    using RegisterSink = std::vector<std::pair<uint8_t, uint64_t>>;
+    static void setRegisterSink(RegisterSink *sink);
 
