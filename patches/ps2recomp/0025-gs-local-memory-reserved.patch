+void PS2Memory::releaseGsVram()
+{
+    if (m_gsVramReserved)
+    {
+#if defined(_WIN32)
+        VirtualFree(m_gsVRAM, 0, MEM_RELEASE);
+#else
+        munmap(m_gsVRAM, PS2_GS_VRAM_SIZE);
+#endif
+    }
+    else
+        delete[] m_gsVRAM;
+    m_gsVRAM = nullptr;
+    m_gsVramReserved = false;
