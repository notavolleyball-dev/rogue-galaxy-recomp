+void EeScheduler::noteGuestUnwind() noexcept
+{
+    ++m_unwindSerial;
+    if (GuestThread *running = currentThread())
+    {
+        running->lastUnwindSerial = m_unwindSerial;
+    }
+}
+
+bool EeScheduler::guestUnwoundSince(uint64_t serial) const
+{
+    const GuestThread *running = currentThread();
+    return running != nullptr && running->lastUnwindSerial > serial;
+}
