+bool EeScheduler::unpacedVBlankHeld(bool start)
+{
+    if (!m_hostWorkPending || hostSpeed() != 0.0)
+    {
+        m_vblankHeld = false;
+        return false;
+    }
+    const uint64_t frames = m_guestFrames.load(std::memory_order_acquire);
+    if (frames == 0u)
+    {
+        return false;
+    }
+    if (frames != m_unpacedFramesSeen)
+    {
+        m_unpacedFramesSeen = frames;
+        m_unpacedVsyncs = 0u;
+        m_vblankHeld = false;
+        m_vblankLetThrough = false;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (m_vblankHeld)
+    {
+        const bool expired = now - m_vblankHeldSince >= kUnpacedVsyncHold;
+        if (!expired && m_hostWorkPending())
+        {
+            return true;
+        }
+        // Out of time (a loading screen), or the host work is done: this
+        // VBlank goes ahead.
+        m_vblankHeld = false;
+        m_vblankLetThrough = true;
+        if (eewait::g_on && expired)
+        {
+            std::lock_guard waitLock(eewait::g_mutex);
+            ++eewait::g_vsyncHoldTimeouts;
+        }
+        return false;
+    }
+    if (!start || m_vblankLetThrough || m_unpacedVsyncs < kUnpacedVsyncsPerFrame || !m_hostWorkPending())
+    {
+        return false;
+    }
+    m_vblankHeld = true;
+    m_vblankHeldSince = now;
+    if (eewait::g_on)
+    {
+        std::lock_guard waitLock(eewait::g_mutex);
+        ++eewait::g_vsyncHolds;
+    }
+    return true;
+}
