+// Plain RAM: an address below 32 MB is never special (every special range
+// starts at 0x10000000 or above), and one whose access ends inside RAM needs
+// neither the mask nor the wrap: one compare instead of the five ranges
+// (Rogue Galaxy: added). Anything else takes the path below, unchanged.
+template <typename T>
+static inline T Ps2PlainRead(const uint8_t *rdram, uint32_t addr)
+{
+    T value;
+    std::memcpy(&value, rdram + addr, sizeof(T));
+    return value;
+}
+template <typename T>
+static inline void Ps2PlainWrite(uint8_t *rdram, uint32_t addr, T value)
+{
+    std::memcpy(rdram + addr, &value, sizeof(T));
+}
+#define PS2_PLAIN_RAM(addr, bytes) __builtin_expect((addr) <= PS2_RAM_SIZE - (bytes), 1)
+
