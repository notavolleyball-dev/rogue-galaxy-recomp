+    if (PS2_PLAIN_RAM(_addr, 1u)) return Ps2PlainRead<uint8_t>(rdram, _addr); \
     return PS2Runtime::isSpecialAddress(_addr)                \
         ? runtime->Load8(rdram, ctx, _addr)                   \
         : FAST_READ8(_addr); }())
 
