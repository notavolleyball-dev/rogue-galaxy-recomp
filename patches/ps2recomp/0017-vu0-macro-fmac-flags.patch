     std::string CodeGenerator::translateVUInstruction(const Instruction &inst)
     {
-        return VuTranslator(*this).translate(inst);
+        std::string code = VuTranslator(*this).translate(inst);
+        if (m_vu0FlagsWanted)
+        {
+            const std::string flags = vu0FmacFlags(inst);
+            if (!flags.empty())
+                code += " " + flags;
+        }
+        return code;
+    }
+
+    // The flag update after a macro FMAC op (ADD, SUB, MUL, MADD, MSUB in
+    // every form, OPMULA, OPMSUB): from the destination's fields once the op
+    // has written them, the accumulator's for the A forms. MAX, MINI, ABS,
+    // the conversions and CLIP leave the MAC and status flags alone.
+    std::string CodeGenerator::vu0FmacFlags(const Instruction &inst) const
+    {
+        if (inst.opcode != OPCODE_COP2 || inst.rs < COP2_CO)
+            return {};
+        const uint32_t dest = inst.vectorInfo.vectorField & 0xFu;
+        const uint8_t special1 = static_cast<uint8_t>(inst.function & 0x3F);
+        if (special1 < 0x3C)
+        {
+            const bool fmac = special1 <= VU0_S1_VMSUBw || (special1 >= VU0_S1_VMULx && special1 <= VU0_S1_VMULq) ||
+                              special1 == VU0_S1_VMULi || (special1 >= VU0_S1_VADDq && special1 <= VU0_S1_VMUL) ||
+                              special1 == VU0_S1_VSUB || special1 == VU0_S1_VMSUB || special1 == VU0_S1_VOPMSUB;
+            if (!fmac)
+                return {};
+            return fmt::format("PS2_VU0_FMAC_FLAGS(ctx, ctx->vu0_vf[{}], {}u);", inst.sa, dest);
+        }
+        const uint8_t special2 = static_cast<uint8_t>((((inst.raw >> 6) & 0x1F) << 2) | (inst.raw & 0x3));
+        const bool fmac = special2 <= VU0_S2_VMSUBAw || (special2 >= VU0_S2_VMULAx && special2 <= VU0_S2_VMULAq) ||
+                          special2 == VU0_S2_VMULAi || (special2 >= VU0_S2_VADDAq && special2 <= VU0_S2_VMULA) ||
+                          special2 == VU0_S2_VSUBA || special2 == VU0_S2_VMSUBA || special2 == VU0_S2_VOPMULA;
+        if (!fmac)
+            return {};
+        return fmt::format("PS2_VU0_FMAC_FLAGS(ctx, ctx->vu0_acc, {}u);", dest);
     }
 
