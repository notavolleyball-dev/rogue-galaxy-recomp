@@ -148,6 +148,24 @@ static inline uint32_t ps2_plzcw32(uint32_t x)
 #define PS2_VMULQ(a, q) _mm_mul_ps((__m128)(a), _mm_set1_ps(q))
 #define PS2_VBLEND(a, b, mask) PS2_BLENDV_PS((__m128)(a), (__m128)(b), (__m128)(mask))
 
+// The MAC and status flags a VU0 macro FMAC op leaves (Rogue Galaxy: added),
+// for the fields of `dest` (the instruction's x=8 y=4 z=2 w=1 mask, the MAC
+// nibbles' order): sign from the result's sign bit, zero on an exact zero,
+// no underflow or overflow (the host's floats have neither the VU's range
+// nor its clamp). Status keeps D and I, sets Z and S from this result and
+// ORs them into their sticky bits.
+static inline void ps2Vu0FmacFlags(uint16_t *status, uint32_t *mac, __m128 result, uint32_t dest)
+{
+    static const uint8_t kFields[16] = {0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15};
+    const uint32_t sign = kFields[_mm_movemask_ps(result)] & dest;
+    const uint32_t zero = kFields[_mm_movemask_ps(_mm_cmpeq_ps(result, _mm_setzero_ps()))] & dest;
+    *mac = (sign << 4) | zero;
+    const uint32_t now = (zero ? 0x1u : 0u) | (sign ? 0x2u : 0u);
+    *status = static_cast<uint16_t>((*status & ~0xFu) | now | (now << 6));
+}
+#define PS2_VU0_FMAC_FLAGS(ctx, value, dest) \
+    ps2Vu0FmacFlags(&(ctx)->vu0_status, &(ctx)->vu0_mac_flags, (value), (dest))
+
