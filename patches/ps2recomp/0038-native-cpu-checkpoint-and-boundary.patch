+void PS2Runtime::nativeCheckpoint(uint32_t cycles)
+{
+    if (!m_eeScheduler->checkpointDue(cycles) || m_eeScheduler->yieldInPlace())
+    {
+        return;
+    }
+    // On a stop the run loop is leaving: unwinding lets the stacks end.
+    if (isStopRequested())
+    {
+        throw EeDispatcherTransfer{};
+    }
+    // Inside an interrupt handler: it runs on to its end, as on the EE.
+}
+
+void PS2Runtime::nativeBoundary(uint8_t *rdram, R5900Context *ctx, uint32_t target, uint32_t ret, bool call)
+{
+    const uint32_t entrySp = getRegU32(ctx, 29);
+    ctx->pc = target;
+    if (call)
+    {
+        // The caller charged the call (NC_CALLCHECK); this is the rest of
+        // directGuestCall, a hook's slot included.
+        const RecompiledFunction fn = lookupFunction(target);
+        const bool returned = fn ? callGuestFunction(rdram, ctx, fn, target, ret)
+                                 : dispatchGuestBranch(rdram, ctx, target, ret - 8u, ret,
+                                                       GuestBranchKind::IndirectCall, "native call");
+        if (returned && getRegU32(ctx, 29) == entrySp)
+        {
+            ctx->pc = ret;
+            return;
+        }
+    }
+    // A tail jump below, or a jump from native code: dispatch from pc, as
+    // the run loop would after an unwind, until the code comes back.
+    for (;;)
+    {
+        if (ctx->pc == ret && getRegU32(ctx, 29) == entrySp)
+        {
+            return;
+        }
+        if (isStopRequested() || ctx->pc == 0u)
+        {
+            throw EeDispatcherTransfer{};
+        }
+        nativeCheckpoint(EeScheduler::kGuestDispatchCycles);
+        const RecompiledFunction fn = lookupFunction(ctx->pc);
+        if (!fn)
+        {
+            reportMissingFunction(rdram, ctx, ctx->pc, ret, GuestBranchKind::DirectJump, "native jump");
+            throw EeDispatcherTransfer{};
+        }
+        pushDispatchPc(ctx->pc);
+        fn(rdram, ctx, this);
+    }
+}
