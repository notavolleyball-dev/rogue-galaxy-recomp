 #include "ThreadNaming.h"
 
+namespace ps2_gs_detail
+{
+    // std::fegetround without the CRT: MXCSR bits 13-14 are the SSE rounding
+    // control, in the order nearest, down, up, toward zero.
+    inline int currentRoundingMode()
+    {
+#if defined(__x86_64__) || defined(_M_X64) || defined(__i386__) || defined(_M_IX86)
+        switch (_mm_getcsr() & 0x6000u)
+        {
+        case 0x2000u: return FE_DOWNWARD;
+        case 0x4000u: return FE_UPWARD;
+        case 0x6000u: return FE_TOWARDZERO;
+        default: return FE_TONEAREST;
+        }
+#else
+        return std::fegetround();
+#endif
+    }
+} // namespace ps2_gs_detail
