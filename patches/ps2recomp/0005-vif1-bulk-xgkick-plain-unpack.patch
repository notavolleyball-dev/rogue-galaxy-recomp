+
 void VU1Interpreter::flushPipelines()
 {
     while (pipelinesPending())
+    {
+        // With only PATH1 left, nothing writes VU memory any more: the rest
+        // of the packet goes out at once, at the clock it would have reached,
+        // instead of a quadword per two cycles of advancing.
+        if (m_xgkick.active && !otherPipelinesPending())
+        {
+            const uint32_t qwords = gatherXgkick();
+            m_cycle += xgkickCycles(qwords);
+            m_state.cycles = m_cycle;
+            finishXgkick();
+            continue;
+        }
         advanceOneCycle();
+    }
 }
 
