+uint32_t VU1Interpreter::gatherXgkick()
+{
+    if (!m_xgkick.active || !m_activeVuData || m_activeVuDataSize == 0u)
+        return 0u;
+
+    // VU memory wraps; the packet buffer does not.
+    const auto copy = [&](uint32_t offset, uint32_t bytes) {
+        while (bytes != 0u)
+        {
+            const uint32_t source = (m_xgkick.sourceAddress + offset) % m_activeVuDataSize;
+            const uint32_t run = std::min(bytes, m_activeVuDataSize - source);
+            std::memcpy(m_xgkick.packet.data() + offset, m_activeVuData + source, run);
+            offset += run;
+            bytes -= run;
+        }
+    };
+
+    uint32_t copied = 0u;
+    for (;;)
+    {
+        if (m_xgkick.currentTagEnd == 0u)
+        {
+            // The same checks progressXgkick makes on a tag's quadword.
+            const uint32_t offset = m_xgkick.copiedBytes;
+            if (offset > XgkickPipeline::kBufferSize - 16u)
+            {
+                reportReservedInstruction(false, 0xFFFFFFFBu);
+                m_xgkick.active = false;
+                return copied;
+            }
+            copy(offset, 16u);
+            m_xgkick.copiedBytes += 16u;
+            ++copied;
+
+            uint64_t tagLo = 0;
+            std::memcpy(&tagLo, m_xgkick.packet.data() + offset, sizeof(tagLo));
+            const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+            const uint32_t format = static_cast<uint32_t>((tagLo >> 58) & 0x3u);
+            uint32_t nreg = static_cast<uint32_t>((tagLo >> 60) & 0xFu);
+            if (nreg == 0u)
+                nreg = 16u;
+
+            uint64_t tagBytes = 16u;
+            if (format == 0u)
+                tagBytes += static_cast<uint64_t>(nloop) * nreg * 16u;
+            else if (format == 1u)
+                tagBytes += ((static_cast<uint64_t>(nloop) * nreg + 1u) & ~1ull) * 8u;
+            else if (format == 2u)
+                tagBytes += static_cast<uint64_t>(nloop) * 16u;
+            else
+            {
+                reportReservedInstruction(false, 0xFFFFFFF8u);
+                m_xgkick.active = false;
+                return copied;
+            }
+
+            if (tagBytes > XgkickPipeline::kBufferSize - offset)
+            {
+                reportReservedInstruction(false, 0xFFFFFFFBu);
+                m_xgkick.active = false;
+                return copied;
+            }
+            m_xgkick.currentTagEnd = offset + static_cast<uint32_t>(tagBytes);
+            m_xgkick.currentTagEop = ((tagLo >> 15) & 1u) != 0u;
+            if (m_xgkick.currentTagEop)
+                m_xgkick.totalBytes = m_xgkick.currentTagEnd;
+        }
+
+        const uint32_t rest = m_xgkick.currentTagEnd - m_xgkick.copiedBytes;
+        if (rest != 0u)
+        {
+            copy(m_xgkick.copiedBytes, rest);
+            m_xgkick.copiedBytes += rest;
+            copied += rest / 16u;
+        }
+        if (m_xgkick.currentTagEop)
+            return copied;
+        // The next quadword is another GIFtag.
+        m_xgkick.currentTagEnd = 0u;
+        m_xgkick.currentTagEop = false;
+    }
+}
+
+uint32_t VU1Interpreter::xgkickCycles(uint32_t qwords) const
+{
+    // progressXgkick adds one credit a cycle and copies a quadword per two;
+    // with credit enough already, the first cycle copies all of them.
+    const uint32_t needed = qwords * 2u;
+    return needed > m_xgkick.cycleCredit ? needed - m_xgkick.cycleCredit : 1u;
+}
