+bool PS2Memory::continueVIF1Image(const uint8_t *data, uint32_t qwc)
+{
+    if (!data || qwc == 0u || m_vif1PendingPath2ImageQwc < qwc || !m_gifImageCallback || m_gifArbiter)
+        return false;
+    m_gifImageCallback(data, qwc * 16u);
+    m_vif1PendingPath2ImageQwc -= qwc;
+    return true;
+}
