diff --git a/ps2xRuntime/include/runtime/gs/gs_boundary.h b/ps2xRuntime/include/runtime/gs/gs_boundary.h
new file mode 100644
index 0000000..cac3e43
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_boundary.h
@@ -0,0 +1,174 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+// The GS boundary (Rogue Galaxy: added; the game's docs/NATIVE-PIPELINE.md).
+//
+// Every way into the GS is a counting site: GIF packets into the frontend
+// (G1), register writes outside packets (G2), uploads into GS memory (G3),
+// reads of it (G4), GS-typed calls into the renderer (G5), the renderer's
+// GS memory model (G6), and the game-side converter decoding GS packets (T,
+// tracked, not gating). With the native renderer on, the renderer is off the
+// GS when every G count reads 0.
+//
+// A site counts per caller: the caller says who it is for the duration of
+// the call (FromScope); a site reached with no caller set counts under "?",
+// which is itself something to find. DQ8_GFX_WARN_GS=1 prints the first hit
+// of each site and caller. Counting is a relaxed atomic add; any thread.
+namespace gs_boundary
+{
+enum Kind : uint8_t
+{
+    kGif,
+    kRegister,
+    kUpload,
+    kRead,
+    kRenderer,
+    kModel,
+    kConverter,
+    kKindCount
+};
+inline constexpr const char *kKindNames[kKindCount] = {"G1 gif", "G2 register", "G3 upload", "G4 read",
+                                                        "G5 renderer", "G6 memory model", "T converter"};
+
+enum From : uint8_t
+{
+    kFromUnknown,
+    kFromPath1,     // the GIF arbiter, PATH1: a VU1 program's XGKICK
+    kFromPath2,     // PATH2: a VIF1 DIRECT
+    kFromPath3,     // PATH3: GIF DMA (the game's 2D packets, uploads)
+    kFromVif1,      // the game's VIF1 thread, sending itself
+    kFromGifStage,  // the game's GIF stage, sending what the VIF1 thread queued
+    kFromKernel,    // a kernel stub (sceGs*)
+    kFromGame,      // a game function hook
+    kFromCount
+};
+inline constexpr const char *kFromNames[kFromCount] = {"?",           "path1",     "path2",       "path3",
+                                                        "vif1 thread", "gif stage", "kernel stub", "game hook"};
+
+inline thread_local From t_from = kFromUnknown;
+
+// Who the calls made in this scope come from. The innermost scope wins: a
+// packet the VIF1 stage hands the GIF arbiter counts as its path.
+struct FromScope
+{
+    From saved;
+    explicit FromScope(From from) : saved(t_from) { t_from = from; }
+    ~FromScope() { t_from = saved; }
+    FromScope(const FromScope &) = delete;
+    FromScope &operator=(const FromScope &) = delete;
+};
+
+struct Site
+{
+    const char *name;
+    Kind kind;
+    bool signature; // name is a __PRETTY_FUNCTION__, shortened when printed
+    std::atomic<uint64_t> counts[kFromCount]{};
+    std::atomic<bool> linked{false};
+    Site *next = nullptr;
+    uint64_t reported[kFromCount]{}; // the reporting thread's last read
+    Site(const char *n, Kind k, bool sig = false) : name(n), kind(k), signature(sig) {}
+};
+
+inline std::atomic<Site *> &head()
+{
+    static std::atomic<Site *> first{nullptr};
+    return first;
+}
+
+inline bool warnEnabled()
+{
+    static const bool on = [] {
+        const char *v = std::getenv("DQ8_GFX_WARN_GS");
+        return v && *v && *v != '0';
+    }();
+    return on;
+}
+
+// A site's printed name: a signature ("ret *ns::Class::method(args)",
+// __PRETTY_FUNCTION__) shortened to "Class::method", any other as it is.
+inline std::string shortName(const Site &site)
+{
+    std::string s(site.name);
+    if (!site.signature)
+        return s;
+    const size_t open = s.find('(');
+    if (open != std::string::npos)
+        s.resize(open);
+    const size_t space = s.rfind(' ');
+    if (space != std::string::npos)
+        s.erase(0, space + 1);
+    while (!s.empty() && (s[0] == '*' || s[0] == '&'))
+        s.erase(0, 1);
+    for (const char *ns : {"dq8::gfx::", "SdlGpuBackend::Impl::"})
+        if (s.compare(0, std::strlen(ns), ns) == 0)
+            s.erase(0, std::strlen(ns));
+    return s;
+}
+
+inline void add(Site &site, uint64_t n = 1u)
+{
+    if (!site.linked.load(std::memory_order_acquire) && !site.linked.exchange(true, std::memory_order_acq_rel))
+    {
+        Site *expected = head().load(std::memory_order_relaxed);
+        do
+            site.next = expected;
+        while (!head().compare_exchange_weak(expected, &site, std::memory_order_release, std::memory_order_relaxed));
+    }
+    const From from = t_from;
+    if (site.counts[from].fetch_add(n, std::memory_order_relaxed) == 0u && warnEnabled())
+        std::fprintf(stderr, "[gs-boundary] first: %s %s from %s\n", kKindNames[site.kind],
+                     shortName(site).c_str(), kFromNames[from]);
+}
+
+// Since the last call (one reporting thread): a summary line of each kind's
+// total (always), then each site hit, by caller.
+inline std::string report()
+{
+    uint64_t totals[kKindCount] = {};
+    std::string sites;
+    for (Site *site = head().load(std::memory_order_acquire); site; site = site->next)
+    {
+        std::string callers;
+        uint64_t siteTotal = 0u;
+        for (int from = 0; from < kFromCount; ++from)
+        {
+            const uint64_t now = site->counts[from].load(std::memory_order_relaxed);
+            const uint64_t delta = now - site->reported[from];
+            site->reported[from] = now;
+            if (delta == 0u)
+                continue;
+            siteTotal += delta;
+            callers += std::string(callers.empty() ? "" : ", ") + kFromNames[from] + " " + std::to_string(delta);
+        }
+        if (siteTotal == 0u)
+            continue;
+        totals[site->kind] += siteTotal;
+        sites += std::string("  ") + kKindNames[site->kind] + " | " + shortName(*site) + ": " +
+                 std::to_string(siteTotal) + " (" + callers + ")\n";
+    }
+    std::string line = "[gs-boundary]";
+    for (int kind = 0; kind < kKindCount; ++kind)
+        line += std::string(kind ? " | " : " ") + kKindNames[kind] + " " + std::to_string(totals[kind]);
+    return line + "\n" + sites;
+}
+} // namespace gs_boundary
+
+#define GS_BOUNDARY_SITE_(kind, name, n, signature)                                \
+    do                                                                            \
+    {                                                                             \
+        static ::gs_boundary::Site gsBoundarySite_{(name), (kind), (signature)};  \
+        ::gs_boundary::add(gsBoundarySite_, static_cast<uint64_t>(n));            \
+    } while (0)
+// One crossing of `kind` at this site, named `name` (a string literal).
+#define GS_BOUNDARY(kind, name) GS_BOUNDARY_SITE_(::gs_boundary::kind, name, 1u, false)
+// `n` at once (packets decoded, bytes).
+#define GS_BOUNDARY_N(kind, name, n) GS_BOUNDARY_SITE_(::gs_boundary::kind, name, n, false)
+// Named after the enclosing function.
+#define GS_BOUNDARY_HERE(kind) GS_BOUNDARY_SITE_(::gs_boundary::kind, __PRETTY_FUNCTION__, 1u, true)
