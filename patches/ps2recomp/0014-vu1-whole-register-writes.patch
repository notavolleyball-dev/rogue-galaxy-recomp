+    // A VF register or ACC written as one 16-byte store. As lane stores, a
+    // masked write (xyz: 8 bytes and 4) cannot forward to the next pair's
+    // 16-byte read of the register, which waits until both have retired; in
+    // Rogue Galaxy's busiest routine that wait was its hottest instruction
+    // (Rogue Galaxy: added, 2026-10-20). Lanes outside Mask keep their value.
+    template <uint8_t Mask>
+    static PS2_VU_FORCE_INLINE void writeVector(float *target, const float *value)
+    {
+#if PS2_VU_PROGRAM_SSE
+        if constexpr (Mask == 0xFu)
+        {
+            _mm_storeu_ps(target, _mm_loadu_ps(value));
+        }
+        else
+        {
+#if defined(__SSE4_1__) || defined(__aarch64__)
+            // Mask bit 8 is x, lane 0; the blend's bit 0 is lane 0.
+            constexpr int blend = ((Mask >> 3u) & 1u) | (((Mask >> 2u) & 1u) << 1u) | (((Mask >> 1u) & 1u) << 2u) |
+                                  ((Mask & 1u) << 3u);
+            _mm_storeu_ps(target, _mm_blend_ps(_mm_loadu_ps(target), _mm_loadu_ps(value), blend));
+#else
+            const __m128 keep = _mm_castsi128_ps(_mm_setr_epi32((Mask & 8u) ? 0 : -1, (Mask & 4u) ? 0 : -1,
+                                                                 (Mask & 2u) ? 0 : -1, (Mask & 1u) ? 0 : -1));
+            _mm_storeu_ps(target, _mm_or_ps(_mm_and_ps(keep, _mm_loadu_ps(target)),
+                                            _mm_andnot_ps(keep, _mm_loadu_ps(value))));
+#endif
+        }
+#else
+        applyLanes<Mask>(target, value);
+#endif
+    }
