/build/
/out/
*.log
# The launcher the build puts beside RogueGalaxy.bat.
/Rogue Galaxy.exe
CMakeUserPresets.json

# Python
__pycache__/
*.pyc

# Editors / OS
.vs/
.vscode/
.idea/
.cache/
Thumbs.db
.DS_Store

# Art collected from the disc while playing (the texture-pack branch).
/textures/
